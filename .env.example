# AI Marine Sentinel - Environment Variables Example
# Copy this file to .env and populate the variables with your actual keys.

# Google Cloud Platform configuration (for BigQuery, GCS, Vertex AI, GEE)
GOOGLE_CLOUD_PROJECT=smart-diet-app-482519
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Cloud Storage & BigQuery settings
GCS_BUCKET_NAME="gs://whale_watch"
GCS_BUCKET_STAGING_NAME="gs://whale_watch_staging"
BIGQUERY_TABLE="platinum-banner-303105.Whale_watch.whale-watch-bq"

# Google Application Credentials (JSON key file path) for GEE & GCP Auth
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Live AIS Stream API key (Get a free key from https://aisstream.io/)
AISSTREAM_API_KEY=

# Google Earth Engine Project Name (Optional, defaults to GOOGLE_CLOUD_PROJECT)
GOOGLE_EARTH_ENGINE_PROJECT=

# NOAA ERDDAP CoastWatch Base URL (Optional, defaults to NOAA CoastWatch public URL)
NOAA_ERDDAP_BASE_URL=https://coastwatch.pfeg.noaa.gov/erddap

# NOAA NDBC Buoy API Base URL (Optional, defaults to https://www.ndbc.noaa.gov)
NDBC_BASE_URL=https://www.ndbc.noaa.gov

# Whale Safe API Key or Endpoint (Optional, for Whale Safe integrations)
WHALE_SAFE_API_KEY_OR_ENDPOINT=

# Whale Alert West Coast API Key or Endpoint (Optional)
WHALE_ALERT_API_KEY_OR_ENDPOINT=

# Research Partners Data URLs (Optional)
MBARI_DATA_URL=
FARALLON_DATA_URL=
